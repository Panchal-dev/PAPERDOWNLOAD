# Copy to .env and fill in. Never commit the real .env file.

# Public base URL used for metadata/canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile public site key (safe to expose).
# Leave empty to disable bot protection in local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (SERVER ONLY — never prefix with NEXT_PUBLIC_).
TURNSTILE_SECRET_KEY=

# Directory for generated PDFs. Defaults to the OS temp dir (gtu-papers/).
# DOWNLOAD_DIR=

# Port for `npm start` (platforms usually inject PORT themselves).
# PORT=3000

# Upstash Redis — unique visitor counter (HyperLogLog).
# Get these from: https://console.upstash.com → your database → REST API tab.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Copy to .env and fill in. Never commit the real .env file.

# Canonical site URL: metadata, robots.txt and sitemap.xml.
# Defaults to https://paper.devang.live when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: build a self-contained Node server (node .next/standalone/server.js).
# NEXT_OUTPUT=standalone

# Port for `npm start` (platforms usually inject PORT themselves).
# PORT=3000

# Optional: Upstash Redis unique visitor counter (hidden when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

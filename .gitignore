# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build output ────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Environment variables ───────────────────────────────────────────────────
# Commit .env.example; ignore all real env files.
.env
.env.*
!.env.example

# ─── Testing & coverage ──────────────────────────────────────────────────────
/coverage
*.lcov

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ─── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor & IDE ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Python (paper.py + tooling) ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# ─── Deployment ──────────────────────────────────────────────────────────────
.vercel

# ─── Certs & keys ────────────────────────────────────────────────────────────
*.pem
*.key

# ─── Misc ────────────────────────────────────────────────────────────────────
*.tgz
.cache/
